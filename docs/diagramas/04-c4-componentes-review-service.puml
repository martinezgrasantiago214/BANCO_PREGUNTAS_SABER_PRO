@startuml c4-componentes-review
!include <C4/C4_Component>
title review-service - C4 Nivel 3: Componentes

Container_Ext(gateway, "API Gateway")
Container_Ext(users, "user-service")
ContainerQueue_Ext(broker, "RabbitMQ")
ContainerDb_Ext(db, "reviews_db")

Container_Boundary(rs, "review-service") {
  Component(ctrl, "ReviewController", "REST adapter", "HU04 asignar; HU05 listar asignadas, evaluar, observar")
  Component(listener, "QuestionEventsListener", "AMQP adapter", "Crea el proceso de revisión al recibir question.submitted")
  Component(service, "ReviewService", "Aplicación")
  Component(aggregate, "QuestionReview (agregado)", "Dominio", "1-3 revisores, rúbrica, observaciones, rondas")
  Component(policy, "DecisionPolicy", "Dominio - Strategy", "UnanimousApprovalPolicy | MajorityPolicy")
  Component(userPort, "UserDirectoryPort", "Puerto")
  Component(userAdapter, "UserDirectoryRestAdapter", "RestClient @LoadBalanced")
  Component(repoAdapter, "ReviewRepositoryAdapter", "JPA + bloqueo optimista")
  Component(pubAdapter, "OutboxReviewEventPublisher", "Outbox adapter", "Escribe los eventos en la misma transacción que la revisión")
  Component(relay, "OutboxRelay", "common-outbox", "Entrega los pendientes con publisher confirms y backoff")
}

Rel(gateway, ctrl, "HTTP JSON")
Rel(broker, listener, "question.submitted")
Rel(ctrl, service, "usa")
Rel(listener, service, "usa")
Rel(service, aggregate, "opera")
Rel(aggregate, policy, "decide con")
Rel(service, userPort, "valida roles")
Rel(userAdapter, userPort, "implementa")
Rel(userAdapter, users, "GET /api/users/{login}")
Rel(service, repoAdapter, "vía puerto")
Rel(repoAdapter, db, "JPA")
Rel(service, pubAdapter, "vía puerto")
Rel(pubAdapter, db, "outbox_message")
Rel(relay, db, "lee pendientes (FOR UPDATE SKIP LOCKED)")
Rel(relay, broker, "review.reviewers-assigned, review.evaluation-submitted, review.observation-added, review.completed")
@enduml
