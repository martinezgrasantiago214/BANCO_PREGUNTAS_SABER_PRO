@startuml c4-contenedores
!include <C4/C4_Container>
title Banco de Preguntas Saber PRO - C4 Nivel 2: Contenedores (microservicios + eventos)

Person(usuario, "Autor / Administrador / Revisor")
System_Ext(smtp, "Servidor SMTP")

System_Boundary(sys, "Banco de Preguntas Saber PRO") {
  Container(desktop, "Frontend de escritorio", "Java 17, Swing, MVC", "Interfaz por rol. Solo conoce la URL del gateway")
  Container(gateway, "API Gateway", "Spring Cloud Gateway", "Punto único de entrada, enrutamiento lb://, Swagger UI unificado")
  Container(eureka, "Discovery Server", "Spring Cloud Netflix Eureka", "Registro y descubrimiento de instancias")

  Container(users, "user-service", "Spring Boot", "Identity & Access: login, registro, roles")
  Container(questions, "question-service", "Spring Boot", "Gestión de preguntas, ciclo de vida (State) y validación estructural")
  Container(reviews, "review-service", "Spring Boot", "Revisión por pares: asignación, rúbrica, observaciones, decisión (Strategy)")
  Container(notifications, "notification-service", "Spring Boot", "Consume eventos y notifica (correo + bandeja). Escala con N réplicas")

  ContainerQueue(broker, "RabbitMQ", "AMQP, exchange topic saberpro.events", "Eventos de integración + DLQ")

  ContainerDb(dbu, "users_db", "PostgreSQL")
  ContainerDb(dbq, "questions_db", "PostgreSQL")
  ContainerDb(dbr, "reviews_db", "PostgreSQL")
  ContainerDb(dbn, "notifications_db", "PostgreSQL")
}

Rel(usuario, desktop, "Usa")
Rel(desktop, gateway, "API REST JSON", "HTTP :8080 + X-User-Login")
Rel(gateway, users, "/api/auth, /api/users", "HTTP lb://")
Rel(gateway, questions, "/api/questions", "HTTP lb://")
Rel(gateway, reviews, "/api/reviews", "HTTP lb://")
Rel(gateway, notifications, "/api/notifications", "HTTP lb://")

Rel(questions, broker, "Publica question.submitted / consume review.reviewers-assigned, review.completed")
Rel(reviews, broker, "Consume question.submitted / publica review.*")
Rel(notifications, broker, "Consume question.submitted y review.#")
Rel(reviews, users, "Valida roles de admin/revisores", "REST lb://")
Rel(notifications, users, "Resuelve nombre y correo", "REST lb://")
Rel(notifications, smtp, "Envía correos", "SMTP")

Rel(users, dbu, "JPA")
Rel(questions, dbq, "JPA")
Rel(reviews, dbr, "JPA")
Rel(notifications, dbn, "JPA")

Rel_U(users, eureka, "Se registra")
Rel_U(questions, eureka, "Se registra")
Rel_U(reviews, eureka, "Se registra")
Rel_U(notifications, eureka, "Se registra")
Rel_U(gateway, eureka, "Descubre instancias")
@enduml
