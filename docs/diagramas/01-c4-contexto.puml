@startuml c4-contexto
!include <C4/C4_Context>
title Banco de Preguntas Saber PRO - C4 Nivel 1: Contexto (Iteración 2)

Person(autor, "Autor de preguntas", "Docente que crea preguntas Saber PRO")
Person(admin, "Administrador", "Asigna revisores a las preguntas")
Person(revisor, "Revisor", "Docente que evalúa preguntas de otros")

System(banco, "Banco de Preguntas Saber PRO", "Gestiona la creación, validación y revisión por pares de preguntas de selección múltiple")
System_Ext(smtp, "Servidor de correo (SMTP)", "Gmail u otro proveedor")

Rel(autor, banco, "Crea, lista, edita y envía preguntas a revisión")
Rel(admin, banco, "Asigna de 1 a 3 revisores")
Rel(revisor, banco, "Lee, califica y aprueba/rechaza; deja observaciones")
Rel(banco, smtp, "Envía notificaciones", "SMTP")
Rel(smtp, revisor, "Correo de asignación")
Rel(smtp, autor, "Correo de observaciones y decisión")
@enduml
