@startuml clases-patrones
title Patrones GoF implementados (vista de clases)
skinparam shadowing false
left to right direction

package "question-service" {
  class Question {
    -state: QuestionState
    +submitForReview()
    +startReview()
    +approve()
    +reject()
    +edit(data, options)
    {static} +builder(): Builder
  }
  class "Question.Builder" as QB <<Builder>> {
    +id() +type() +option() ... +build(): Question
  }
  interface QuestionState <<State>> {
    +submitForReview(): QuestionState
    +startReview(): QuestionState
    +approve(): QuestionState
    +reject(): QuestionState
    +edit(): QuestionState
  }
  class DraftState
  class PendingReviewState
  class InReviewState
  class ApprovedState
  class RejectedState
  abstract class QuestionTypePlugin <<Creator - Factory Method>> {
    +generate(data): Question
    #createQuestion(data): Question
  }
  class MultipleChoiceQuestionPlugin
  abstract class QuestionValidationHandler <<Chain of Responsibility>> {
    -next
    +linkWith(next)
    +validate(data)
    #check(data)
  }
  Question *-- QuestionState
  QuestionState <|.. DraftState
  QuestionState <|.. PendingReviewState
  QuestionState <|.. InReviewState
  QuestionState <|.. ApprovedState
  QuestionState <|.. RejectedState
  Question +-- QB
  QuestionTypePlugin <|-- MultipleChoiceQuestionPlugin
  MultipleChoiceQuestionPlugin ..> QB : usa
  QuestionTypePlugin ..> QuestionValidationHandler
}

package "review-service" {
  class QuestionReview
  interface DecisionPolicy <<Strategy>> {
    +decide(assignments): Optional<Verdict>
  }
  class UnanimousApprovalPolicy
  class MajorityPolicy
  QuestionReview ..> DecisionPolicy
  DecisionPolicy <|.. UnanimousApprovalPolicy
  DecisionPolicy <|.. MajorityPolicy
}

package "notification-service" {
  interface EmailSenderPort <<Target>> {
    +send(message): DeliveryStatus
  }
  class SmtpEmailSenderAdapter <<Adapter>>
  class OutboxFileEmailSenderAdapter <<Adapter>>
  class JavaMailSender <<Adaptee>>
  EmailSenderPort <|.. SmtpEmailSenderAdapter
  EmailSenderPort <|.. OutboxFileEmailSenderAdapter
  SmtpEmailSenderAdapter --> JavaMailSender
  abstract class NotificationTemplate <<Template Method>> {
    +compose(event, directory)
    #recipients() #subject() #body()
  }
}

package "frontend-desktop" {
  class SaberProApiFacade <<Facade>>
  class UserApiClient
  class QuestionApiClient
  class ReviewApiClient
  class NotificationApiClient
  SaberProApiFacade --> UserApiClient
  SaberProApiFacade --> QuestionApiClient
  SaberProApiFacade --> ReviewApiClient
  SaberProApiFacade --> NotificationApiClient
  class AppEvents <<Subject>>
  interface AppObserver <<Observer>>
  AppEvents o-- AppObserver
}
@enduml
