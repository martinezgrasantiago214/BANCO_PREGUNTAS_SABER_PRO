@startuml c4-componentes-question
!include <C4/C4_Component>
title question-service - C4 Nivel 3: Componentes (arquitectura hexagonal)

Container_Ext(gateway, "API Gateway")
ContainerQueue_Ext(broker, "RabbitMQ")
ContainerDb_Ext(db, "questions_db")

Container_Boundary(qs, "question-service") {
  Component(ctrl, "QuestionController", "REST adapter (entrada)", "HU01-HU03, catálogos de estados con color")
  Component(listener, "ReviewEventsListener", "AMQP adapter (entrada)", "Reacciona a reviewers-assigned y completed (idempotente)")
  Component(service, "QuestionService", "Aplicación", "Casos de uso; depende solo de puertos")
  Component(registry, "QuestionTypeRegistry + QuestionTypePlugin", "Dominio - Microkernel + Factory Method", "Plugins cargados por reflexión")
  Component(chain, "QuestionValidationHandler (cadena)", "Dominio - Chain of Responsibility", "5 reglas de validación estructural")
  Component(question, "Question (agregado)", "Dominio - Builder + State", "Ciclo de vida delegado en QuestionState")
  Component(repoPort, "QuestionRepositoryPort", "Puerto de salida")
  Component(pubPort, "QuestionEventPublisherPort", "Puerto de salida")
  Component(repoAdapter, "QuestionRepositoryAdapter", "JPA adapter (salida)", "Specifications para filtros y paginación")
  Component(pubAdapter, "RabbitQuestionEventPublisher", "AMQP adapter (salida)")
}

Rel(gateway, ctrl, "HTTP JSON")
Rel(broker, listener, "Eventos de revisión")
Rel(ctrl, service, "usa")
Rel(listener, service, "usa")
Rel(service, registry, "pide el plugin del tipo")
Rel(registry, chain, "valida con")
Rel(registry, question, "fabrica")
Rel(service, repoPort, "usa")
Rel(service, pubPort, "usa")
Rel(repoAdapter, repoPort, "implementa")
Rel(pubAdapter, pubPort, "implementa")
Rel(repoAdapter, db, "JPA")
Rel(pubAdapter, broker, "question.submitted")
@enduml
