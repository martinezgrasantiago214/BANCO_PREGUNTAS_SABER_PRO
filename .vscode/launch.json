{
  // Run and Debug (Cmd/Ctrl + Shift + D) -> "Banco de Preguntas (todo el sistema)" -> Play.
  // Enciende los 4 microservicios, el API Gateway y el frontend de una vez.
  // Requisito: RabbitMQ encendido (brew services start rabbitmq, o: docker compose up rabbitmq).
  // Esperar unos 20 segundos antes de iniciar sesion.
  "version": "0.2.0",
  "configurations": [
    { "type": "java", "name": "user-service", "request": "launch",
      "mainClass": "co.unicauca.saberpro.user.UserServiceApplication", "projectName": "user-service" },
    { "type": "java", "name": "question-service", "request": "launch",
      "mainClass": "co.unicauca.saberpro.question.QuestionServiceApplication", "projectName": "question-service" },
    { "type": "java", "name": "review-service", "request": "launch",
      "mainClass": "co.unicauca.saberpro.review.ReviewServiceApplication", "projectName": "review-service" },
    { "type": "java", "name": "notification-service", "request": "launch",
      "mainClass": "co.unicauca.saberpro.notification.NotificationServiceApplication", "projectName": "notification-service" },
    { "type": "java", "name": "api-gateway", "request": "launch",
      "mainClass": "co.unicauca.saberpro.gateway.ApiGatewayApplication", "projectName": "api-gateway" },
    { "type": "java", "name": "frontend", "request": "launch",
      "mainClass": "co.unicauca.saberpro.frontend.MainApp", "projectName": "frontend" }
  ],
  "compounds": [
    {
      "name": "Banco de Preguntas (todo el sistema)",
      "configurations": ["user-service", "question-service", "review-service",
                         "notification-service", "api-gateway", "frontend"],
      "stopAll": true
    }
  ]
}
