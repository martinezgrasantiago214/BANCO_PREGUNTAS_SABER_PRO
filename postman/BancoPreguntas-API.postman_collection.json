        "description": "Pasa por el microkernel y el pipeline de 5 filtros. Guarda el id en {{questionId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"MULTIPLE_CHOICE\",\n  \"context\": \"Una empresa necesita que su banco de preguntas admita nuevos tipos de pregunta sin modificar el nucleo del sistema.\",\n  \"directQuestion\": \"¿Que patron arquitectonico permite agregar funcionalidad mediante plugins sin modificar el nucleo?\",\n  \"distractors\": [\n    \"Microkernel\",\n    \"Cliente-Servidor\",\n    \"Capas\",\n    \"Broker\"\n  ],\n  \"correctAnswer\": \"Microkernel\",\n  \"justification\": \"El patron Microkernel separa un nucleo minimo de los plugins que extienden su funcionalidad.\",\n  \"bibliography\": \"Richards, M. Software Architecture Patterns. O'Reilly, 2015.\",\n  \"competence\": \"Arquitectura de software\",\n  \"topic\": \"Patrones arquitectonicos\",\n  \"subtopic\": \"Microkernel\",\n  \"difficultyLevel\": \"MEDIO\",\n  \"authorLogin\": \"autor1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('questionId', pm.response.json().id);"
            ]
          }
        }
