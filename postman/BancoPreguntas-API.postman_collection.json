    {
      "name": "07 GET tipos de pregunta",
      "request": {
        "method": "GET",
        "header": [],
        "url": {"raw": "{{baseUrl}}/api/questions/types", "host": ["{{baseUrl}}"], "path": ["api", "questions", "types"]},
        "description": "question-service. Fabricas (Factory Method) cargadas por reflexion."
      }
    },
    {
      "name": "08 POST crear pregunta (HU01) [PSP-16/17/18]",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set('questionId', pm.response.json().id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": {"raw": "{{baseUrl}}/api/questions", "host": ["{{baseUrl}}"], "path": ["api", "questions"]},
        "description": "201 y guarda el id en questionId. Hasta implementar PSP-18 responde 501.",
        "body": {"mode": "raw", "raw": "{\n  \"type\": \"MULTIPLE_CHOICE\",\n  \"context\": \"Una empresa necesita que su banco de preguntas admita nuevos tipos de pregunta sin modificar el nucleo del sistema.\",\n  \"directQuestion\": \"¿Que patron arquitectonico permite agregar funcionalidad mediante plugins sin modificar el nucleo?\",\n  \"distractors\": [\"Microkernel\", \"Cliente-Servidor\", \"Capas\", \"Broker\"],\n  \"correctAnswer\": \"Microkernel\",\n  \"justification\": \"El patron Microkernel separa un nucleo minimo de los plugins que extienden su funcionalidad.\",\n  \"bibliography\": \"Richards, M. Software Architecture Patterns. O'Reilly, 2015.\",\n  \"competence\": \"Arquitectura de software\",\n  \"topic\": \"Patrones arquitectonicos\",\n  \"subtopic\": \"Microkernel\",\n  \"difficultyLevel\": \"MEDIO\",\n  \"authorLogin\": \"autor1\"\n}"}
      }
    },
    {
      "name": "09 GET mis preguntas con filtros y paginacion (HU03) [PSP-24..27]",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/questions?author=autor1&status=BORRADOR&keyword=patron&page=1&size=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "questions"],
          "query": [
            {"key": "author", "value": "autor1"},
            {"key": "status", "value": "BORRADOR"},
            {"key": "keyword", "value": "patron"},
            {"key": "page", "value": "1"},
            {"key": "size", "value": "10"}
          ]
        }
      }
    },
    {
      "name": "10 GET pregunta por id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {"raw": "{{baseUrl}}/api/questions/{{questionId}}", "host": ["{{baseUrl}}"], "path": ["api", "questions", "{{questionId}}"]},
        "description": "200, o 404 si no existe. Incluye status, statusLabel y statusColor (HU02)."
      }
    },
    {
      "name": "11 PUT editar pregunta (HU03) [PSP-28]",
      "request": {
        "method": "PUT",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": {"raw": "{{baseUrl}}/api/questions/{{questionId}}", "host": ["{{baseUrl}}"], "path": ["api", "questions", "{{questionId}}"]},
        "description": "Solo el autor y solo en Borrador.",
        "body": {"mode": "raw", "raw": "{\n  \"type\": \"MULTIPLE_CHOICE\",\n  \"context\": \"Contexto editado de la pregunta.\",\n  \"directQuestion\": \"¿Que patron permite agregar plugins sin tocar el nucleo?\",\n  \"distractors\": [\"Microkernel\", \"Cliente-Servidor\", \"Capas\", \"Broker\"],\n  \"correctAnswer\": \"Microkernel\",\n  \"justification\": \"El Microkernel separa el nucleo de los plugins.\",\n  \"bibliography\": \"Richards, M. Software Architecture Patterns. O'Reilly, 2015.\",\n  \"competence\": \"Arquitectura de software\",\n  \"topic\": \"Patrones arquitectonicos\",\n  \"subtopic\": \"Microkernel\",\n  \"difficultyLevel\": \"ALTO\",\n  \"authorLogin\": \"autor1\"\n}"}
      }
    },
    {
      "name": "12 PATCH enviar a revision (HU02) [PSP-21]",
      "request": {
        "method": "PATCH",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": {"raw": "{{baseUrl}}/api/questions/{{questionId}}/submit-review", "host": ["{{baseUrl}}"], "path": ["api", "questions", "{{questionId}}", "submit-review"]},
        "description": "Borrador -> Pendiente de revision. Publica el evento question.submitted.",
        "body": {"mode": "raw", "raw": "{\n  \"authorLogin\": \"autor1\"\n}"}
      }
    },
    {
      "name": "13 GET preguntas pendientes de revision (HU04) [PSP-30]",
      "request": {
        "method": "GET",
        "header": [],
        "url": {"raw": "{{baseUrl}}/api/reviews/pending-questions", "host": ["{{baseUrl}}"], "path": ["api", "reviews", "pending-questions"]}
      }
    },
    {
      "name": "14 POST asignar revisores (HU04) [PSP-31..34]",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": {"raw": "{{baseUrl}}/api/reviews/assignments", "host": ["{{baseUrl}}"], "path": ["api", "reviews", "assignments"]},
        "description": "Entre 1 y 3 revisores. Publica review.assigned y el notification-service envia los correos.",
        "body": {"mode": "raw", "raw": "{\n  \"questionId\": \"{{questionId}}\",\n  \"reviewers\": [\"rev1\", \"rev2\"],\n  \"assignedBy\": \"admin\"\n}"}
      }
    },
    {
