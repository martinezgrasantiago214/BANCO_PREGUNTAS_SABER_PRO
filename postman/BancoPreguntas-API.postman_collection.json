      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/reviews/assignments?reviewer=rev1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "reviews", "assignments"],
          "query": [{"key": "reviewer", "value": "rev1"}]
        }
      }
    },
    {
      "name": "16 POST evaluar pregunta (HU05) [PSP-47..49]",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": {"raw": "{{baseUrl}}/api/reviews/evaluations", "host": ["{{baseUrl}}"], "path": ["api", "reviews", "evaluations"]},
        "description": "verdict: APROBADA o RECHAZADA. Publica review.evaluated (cambia el estado y notifica).",
        "body": {"mode": "raw", "raw": "{\n  \"questionId\": \"{{questionId}}\",\n  \"reviewerLogin\": \"rev1\",\n  \"verdict\": \"RECHAZADA\",\n  \"observations\": \"El distractor 'Capas' es demasiado obvio; reemplazarlo.\"\n}"}
      }
    },
    {
      "name": "17 GET observaciones de una pregunta (HU05) [PSP-47]",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/reviews/evaluations?questionId={{questionId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "reviews", "evaluations"],
          "query": [{"key": "questionId", "value": "{{questionId}}"}]
        }
      }
    },
