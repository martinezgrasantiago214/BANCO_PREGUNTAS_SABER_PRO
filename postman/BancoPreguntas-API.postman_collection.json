        "url": {"raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"]},
        "description": "user-service. 201, o 400 si el login ya existe o la clave no cumple la politica.",
        "body": {"mode": "raw", "raw": "{\n  \"login\": \"rev3\",\n  \"fullName\": \"Docente Revisor Tres\",\n  \"email\": \"rev3@unicauca.edu.co\",\n  \"role\": \"REVISOR\",\n  \"password\": \"Revisor123!\"\n}"}
      }
