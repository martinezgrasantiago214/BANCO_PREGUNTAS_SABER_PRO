      "name": "05 GET revisores (HU04)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {"raw": "{{baseUrl}}/api/users/reviewers", "host": ["{{baseUrl}}"], "path": ["api", "users", "reviewers"]}
      }
