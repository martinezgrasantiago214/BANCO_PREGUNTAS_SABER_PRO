  },
  "item": [
    {
      "name": "01 POST login (autor1)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": {"raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"]},
        "description": "user-service. 200 con los datos del usuario.",
        "body": {"mode": "raw", "raw": "{\n  \"login\": \"autor1\",\n  \"password\": \"Autor123!\"\n}"}
      }
    },
    {
      "name": "02 POST login con clave incorrecta (401)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": {"raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"]},
        "body": {"mode": "raw", "raw": "{\n  \"login\": \"autor1\",\n  \"password\": \"incorrecta\"\n}"}
      }
